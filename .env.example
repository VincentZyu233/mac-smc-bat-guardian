
# Console log level: debug, info, warn, error, silent
CONSOLE_LOG_LEVEL=info
# File log level: debug, info, warn, error, silent
FILE_LOG_LEVEL=info
# 兼容旧变量名，优先使用上面两个
# LOG_LEVEL=info

# Battery monitoring threshold
BATTERY_THRESHOLD=55

# Path to battery info (Linux)
BAT_PATH=/sys/class/power_supply/BAT0
AC_PATH=/sys/class/power_supply/ADP1
# Path to SMC (for fan speed)
SMC_PATH=/sys/devices/platform/applesmc.768
# TUI refresh interval in milliseconds
TUI_REFRESH_MS=500
# Language: en, zh-cn
LANG=en
# Fan speed unit: rpm (divided by 4) or r4 (raw value)
FAN_UNIT=rpm
